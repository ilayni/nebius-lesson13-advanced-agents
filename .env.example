# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Nebius Token Factory API key (required)
NEBIUS_API_KEY=your_nebius_api_key_here

# Optional: override default model IDs
# GENERATION_MODEL=meta-llama/Llama-3.3-70B-Instruct
# ROUTER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Optional: LangSmith tracing (useful with LangGraph Studio)
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=assignment-3
# LANGCHAIN_TRACING_V2=true
